-- Medication Table
CREATE TABLE Medication (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  time TEXT NOT NULL,
  isTaken INTEGER NOT NULL DEFAULT 0
);

selectAllMedications:
SELECT * FROM Medication ORDER BY time ASC;

insertMedication:
INSERT INTO Medication(name, time, isTaken) VALUES (?, ?, 0);

deleteMedicationById:
DELETE FROM Medication WHERE id = ?;

updateMedicationTaken:
UPDATE Medication SET isTaken = ? WHERE id = ?;

-- Water Table
CREATE TABLE Water (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  timestamp TEXT NOT NULL
);

selectAllWater:
SELECT * FROM Water ORDER BY timestamp DESC;

insertWater:
INSERT INTO Water(timestamp) VALUES (?);

deleteWaterById:
DELETE FROM Water WHERE id = ?;

-- Meal Table
CREATE TABLE Meal (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  type TEXT NOT NULL,
  description TEXT NOT NULL,
  timestamp TEXT NOT NULL
);

selectAllMeals:
SELECT * FROM Meal ORDER BY timestamp DESC;

insertMeal:
INSERT INTO Meal(type, description, timestamp) VALUES (?, ?, ?);

deleteMealById:
DELETE FROM Meal WHERE id = ?;